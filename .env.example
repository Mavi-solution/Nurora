# ---------------------------------------------------------------------
# Supabase — Project Settings → API
# ---------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Service role key. Server-only: it bypasses RLS and is used exclusively
# by the reminder cron. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------
# App
# ---------------------------------------------------------------------
# Absolute origin used in reminder emails and OAuth redirects.
# Leave unset on Vercel and it falls back to the deployment URL.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET".
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Google sign-in is hidden unless this is "true". Only enable it once the
# Google provider is actually configured in Supabase, otherwise the button
# is there but always fails.
NEXT_PUBLIC_ENABLE_GOOGLE_AUTH=false

# ---------------------------------------------------------------------
# Email reminders — Resend (optional; skipped cleanly when unset)
# ---------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=Nurora <reminders@yourdomain.com>

# ---------------------------------------------------------------------
# SMS / WhatsApp reminders — Twilio (optional; skipped cleanly when unset)
# ---------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=+15551234567
# Twilio sandbox number looks like: whatsapp:+14155238886
TWILIO_WHATSAPP_FROM=

# Approved WhatsApp templates (Twilio Content SIDs, "HX...").
#
# Meta blocks free-form business-initiated WhatsApp messages outside a
# 24-hour customer-service window, and a booking confirmation is always
# business-initiated — so production needs approved templates here.
# Leave them blank and the app sends free-form text instead, which is
# what the Twilio sandbox accepts in development.
#
# Register each template with these positional variables, in order:
#   {{1}} recipient name   {{2}} other party   {{3}} date & time
#   {{4}} duration         {{5}} where / join  {{6}} practice name
TWILIO_WHATSAPP_TEMPLATE_BOOKED=
TWILIO_WHATSAPP_TEMPLATE_RESCHEDULED=
TWILIO_WHATSAPP_TEMPLATE_CANCELLED=

# Numbers stored without a country code get this one prepended before
# they are dialled. A stored "09876543210" becomes "+919876543210".
NOTIFY_DEFAULT_COUNTRY_CODE=+91

# Practice name used in the WhatsApp/SMS/email wording.
NEXT_PUBLIC_PRACTICE_NAME=Nurora

# ---------------------------------------------------------------------
# Billing — the clinic's money rules
#
# ARCHITECTURE.md rule 2 fixes the SHAPE of these formulas; the numbers
# live in the clinic's settings and were not part of the handoff, so
# they are read from here. LEFT UNSET THE ADVANCE TIERS ARE ZERO — only
# the full-payment modes (Online, Walk-in) will ask for anything.
# Set these before taking real bookings.
# ---------------------------------------------------------------------
# In rupees. A service priced at or below the threshold owes the lower
# advance; above it, the higher one.
BILLING_ADVANCE_TIER_THRESHOLD=
BILLING_ADVANCE_AT_OR_BELOW=
BILLING_ADVANCE_ABOVE=

# Session length included in the base price, and the overrun tolerated
# before any extension is charged.
BILLING_INCLUDED_MINUTES=60
BILLING_GRACE_MINUTES=

# Extensions are billed in whole blocks. Price in rupees.
BILLING_EXTENSION_BLOCK_MINUTES=15
BILLING_EXTENSION_BLOCK_PRICE=

# How grace behaves once exceeded:
#   gate    (default) blocks counted from the end of the included time
#   deduct            the grace minutes are free too
# On a 60-min session running 95 min that is 3 blocks vs 2 — real money.
# Confirm against computeBill() in the original frontend.
BILLING_GRACE_MODE=gate
